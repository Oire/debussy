{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.claude/hooks/cross-platform/check-american-english.ps1\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.claude/hooks/windows-only/check-no-null-redirect.ps1\"",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.claude/hooks/cross-platform/check-git-guard.ps1\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
